<Window
    x:Class="WinDayFlow.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:WinDayFlow.App.Views"
    Title="WinDayFlow">
    <Grid x:Name="WindowRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            AutoRefreshDragRegions="True"
            AutomationProperties.AutomationId="AppTitleBar"
            AutomationProperties.Name="WinDayFlow 窗口标题栏"
            Title="WinDayFlow" />

        <views:ShellPage x:Name="ShellContent" Grid.Row="1" />
    </Grid>
</Window>
