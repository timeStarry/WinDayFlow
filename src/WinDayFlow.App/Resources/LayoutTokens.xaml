<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <x:Double x:Key="Spacing4">4</x:Double>
    <x:Double x:Key="Spacing8">8</x:Double>
    <x:Double x:Key="Spacing12">12</x:Double>
    <x:Double x:Key="Spacing16">16</x:Double>
    <x:Double x:Key="Spacing24">24</x:Double>
    <x:Double x:Key="Spacing32">32</x:Double>
    <x:Double x:Key="NavigationOpenPaneLength">248</x:Double>
    <x:Double x:Key="NavigationCompactPaneLength">56</x:Double>
    <x:Double x:Key="PageContentMaxWidth">1440</x:Double>
    <x:Double x:Key="SettingsContentMaxWidth">920</x:Double>
    <Thickness x:Key="PagePadding">24,16,24,24</Thickness>
    <Thickness x:Key="PanelPadding">20</Thickness>
    <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
    <CornerRadius x:Key="PanelCornerRadius">8</CornerRadius>
    <Style x:Key="SettingsGroupBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PanelCornerRadius}" />
    </Style>
</ResourceDictionary>
