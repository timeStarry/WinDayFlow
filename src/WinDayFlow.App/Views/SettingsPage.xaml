<Page
    x:Class="WinDayFlow.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinDayFlow.App.Controls"
    xmlns:presentation="using:WinDayFlow.Presentation.Settings">
    <Grid>
        <NavigationView
            x:Name="SettingsNavigation"
            Background="Transparent"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            PaneDisplayMode="Top"
            SelectionChanged="OnSettingsSectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="RecordingSettingsNavigationItem" Content="录制" Tag="capture" />
                <NavigationViewItem Content="存储" Tag="storage" />
                <NavigationViewItem Content="隐私与处理" Tag="privacy" />
                <NavigationViewItem Content="供应商" Tag="providers" />
                <NavigationViewItem Content="外观" Tag="appearance" />
                <NavigationViewItem Content="关于" Tag="about" />
            </NavigationView.MenuItems>
        <ScrollViewer
            Padding="{StaticResource PagePadding}"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Visible">
            <StackPanel
                MaxWidth="{StaticResource SettingsContentMaxWidth}"
                HorizontalAlignment="Center"
                Spacing="28">
                <InfoBar
                    x:Name="SettingsErrorInfoBar"
                    AutomationProperties.LiveSetting="Assertive"
                    IsClosable="False"
                    Severity="Error"
                    Title="无法完成设置操作" />

                <StackPanel x:Name="AppearanceSection" Spacing="12" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="外观" />
                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid
                            x:Name="ThemeSettingLayout"
                            Padding="20"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="应用主题" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="选择 WinDayFlow 如何跟随 Windows 外观。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="ThemePicker"
                                Grid.Column="1"
                                MaxWidth="260"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ThemePicker"
                                AutomationProperties.Name="应用主题"
                                SelectionChanged="OnThemeChanged">
                                <ComboBoxItem Content="使用系统设置" Tag="System" />
                                <ComboBoxItem Content="浅色" Tag="Light" />
                                <ComboBoxItem Content="深色" Tag="Dark" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="CaptureSection" Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="录制" />
                    <InfoBar
                        x:Name="CaptureInfoBar"
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind ViewModel.CaptureAvailabilityText, Mode=OneWay}"
                        Severity="Informational"
                        Title="录制状态" />

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid
                            x:Name="ConsentSettingLayout"
                            Padding="20"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="录制授权" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.ConsentStatusText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource MetadataTextStyle}"
                                    Text="{x:Bind ViewModel.ConsentDetailText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel
                                x:Name="ConsentActionPanel"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="GrantConsentButton"
                                    Click="OnGrantConsent"
                                    AutomationProperties.AutomationId="GrantRecordingConsentButton"
                                    AutomationProperties.Name="查看录制说明并同意"
                                    IsEnabled="{x:Bind ViewModel.CanGrantConsent, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <TextBlock Text="查看并同意" TextWrapping="NoWrap" />
                                </Button>
                                <Button
                                    x:Name="RevokeConsentButton"
                                    Click="OnRevokeConsent"
                                    AutomationProperties.AutomationId="RevokeRecordingConsentButton"
                                    AutomationProperties.Name="撤回录制同意"
                                    IsEnabled="{x:Bind ViewModel.CanRevokeConsent, Mode=OneWay}">
                                    <TextBlock Text="撤回同意" TextWrapping="NoWrap" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid
                            x:Name="CaptureSettingLayout"
                            Padding="20"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="记录屏幕活动" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="启用后，活动证据会保存在本机并用于生成时间线。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="CaptureToggle"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="CaptureToggle"
                                AutomationProperties.Name="记录屏幕活动"
                                IsEnabled="{x:Bind ViewModel.CanChangeCapture, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.CaptureEnabled, Mode=OneWay}"
                                OffContent="关闭"
                                OnContent="开启"
                                Toggled="OnCaptureToggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid
                            x:Name="CaptureIntervalSettingLayout"
                            Padding="20"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="截屏间隔" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="较长间隔占用更少本地空间，也会减少分析图片数量。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="CaptureIntervalPicker"
                                Grid.Column="1"
                                MaxWidth="260"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="CaptureIntervalPicker"
                                AutomationProperties.Name="截屏间隔"
                                IsEnabled="{x:Bind ViewModel.CanChangeCaptureInterval, Mode=OneWay}"
                                SelectionChanged="OnCaptureIntervalChanged">
                                <ComboBoxItem Content="5 秒" Tag="5" />
                                <ComboBoxItem Content="10 秒" Tag="10" />
                                <ComboBoxItem Content="15 秒" Tag="15" />
                                <ComboBoxItem Content="30 秒" Tag="30" />
                                <ComboBoxItem Content="60 秒" Tag="60" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="StorageSection" Spacing="12" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="存储" />
                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid
                            x:Name="StorageSettingLayout"
                            Padding="20"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="本地数据目录" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="时间线、授权记录和设置保存在当前用户目录。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Grid
                                x:Name="DataFolderControlLayout"
                                Grid.Column="1"
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    x:Name="DataFolderTextBox"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="DataFolderPath"
                                    AutomationProperties.Name="本地数据目录"
                                    IsReadOnly="True" />
                                <Button
                                    Grid.Column="1"
                                    Width="40"
                                    Height="40"
                                    Padding="0"
                                    Click="OnOpenDataFolder"
                                    AutomationProperties.Name="打开本地数据目录"
                                    ToolTipService.ToolTip="打开文件夹">
                                    <FontIcon FontSize="16" Glyph="&#xE8B7;" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid
                            x:Name="RetentionSettingLayout"
                            Padding="20"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="屏幕证据保留期限" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="到期证据将在没有待处理任务引用时进入清理队列。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="RetentionPicker"
                                Grid.Column="1"
                                MaxWidth="260"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="EvidenceRetentionPicker"
                                AutomationProperties.Name="屏幕证据保留期限"
                                IsEnabled="{x:Bind ViewModel.CanChangePrivacy, Mode=OneWay}"
                                SelectionChanged="OnRetentionChanged">
                                <ComboBoxItem Content="不自动清理" Tag="0" />
                                <ComboBoxItem Content="7 天" Tag="7" />
                                <ComboBoxItem Content="30 天" Tag="30" />
                                <ComboBoxItem Content="90 天" Tag="90" />
                                <ComboBoxItem Content="1 年" Tag="365" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="PrivacySection" Spacing="12" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="隐私与处理" />

                    <InfoBar
                        x:Name="RoutingInfoBar"
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="False"
                        IsOpen="False" />

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <StackPanel Padding="20" Spacing="16">
                            <Grid
                                x:Name="PrivacyHeaderLayout"
                                ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="隐私检查" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="可选检查明文密码、密钥和令牌；关闭时直接使用原始截图。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="PrivacyToggle"
                                    Grid.Column="1"
                                    AutomationProperties.Name="启用隐私检查"
                                    IsEnabled="{x:Bind RoutingViewModel.CanMutate, Mode=OneWay}"
                                    IsOn="{x:Bind RoutingViewModel.PrivacyEnabled, Mode=TwoWay}"
                                    OffContent="关闭"
                                    OnContent="启用" />
                            </Grid>
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                Header="供应商"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{x:Bind RoutingViewModel.Profiles, Mode=OneWay}"
                                PlaceholderText="选择供应商"
                                SelectedItem="{x:Bind RoutingViewModel.PrivacyProvider, Mode=TwoWay}" />
                            <Grid
                                x:Name="PrivacyPolicyLayout"
                                ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ComboBox
                                    x:Name="PrivacyOnMatchPicker"
                                    HorizontalAlignment="Stretch"
                                    Header="检测到敏感内容"
                                    SelectedIndex="{x:Bind RoutingViewModel.PrivacyOnMatchIndex, Mode=TwoWay}">
                                    <x:String>仅记录审计</x:String>
                                    <x:String>打码后继续</x:String>
                                    <x:String>本地暂缓</x:String>
                                    <x:String>需要复核</x:String>
                                </ComboBox>
                                <ComboBox
                                    x:Name="PrivacyOnErrorPicker"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    Header="检查失败"
                                    SelectedIndex="{x:Bind RoutingViewModel.PrivacyOnErrorIndex, Mode=TwoWay}">
                                    <x:String>本地暂缓</x:String>
                                    <x:String>直接继续</x:String>
                                    <x:String>需要复核</x:String>
                                </ComboBox>
                            </Grid>
                            <Button
                                HorizontalAlignment="Left"
                                Click="OnSavePrivacyRoute"
                                IsEnabled="{x:Bind RoutingViewModel.CanMutate, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Save" />
                                    <TextBlock Text="保存隐私设置" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <StackPanel Padding="20" Spacing="16">
                            <Grid
                                x:Name="TimelineHeaderLayout"
                                ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="时间线分析" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="分析可发送的证据并重写最近 45 分钟时间线；关闭不影响本地录制。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="TimelineToggle"
                                    Grid.Column="1"
                                    AutomationProperties.Name="启用时间线分析"
                                    IsEnabled="{x:Bind RoutingViewModel.CanMutate, Mode=OneWay}"
                                    IsOn="{x:Bind RoutingViewModel.TimelineEnabled, Mode=TwoWay}"
                                    OffContent="关闭"
                                    OnContent="启用" />
                            </Grid>
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                Header="供应商"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{x:Bind RoutingViewModel.Profiles, Mode=OneWay}"
                                PlaceholderText="选择供应商"
                                SelectedItem="{x:Bind RoutingViewModel.TimelineProvider, Mode=TwoWay}" />
                            <Button
                                HorizontalAlignment="Left"
                                Click="OnSaveTimelineRoute"
                                IsEnabled="{x:Bind RoutingViewModel.CanMutate, Mode=OneWay}"
                                Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <SymbolIcon Symbol="Save" />
                                    <TextBlock Text="保存分析设置" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid
                                x:Name="ExclusionRulesHeaderLayout"
                                Padding="20"
                                ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="不发送规则" />
                                    <TextBlock
                                        x:Name="ExclusionRuleSummaryTextBlock"
                                        AutomationProperties.LiveSetting="Polite"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="没有自定义规则"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="ExclusionRuleAvailabilityTextBlock"
                                        Style="{StaticResource MetadataTextStyle}"
                                        Text="规则在每次实际请求前检查，只阻止联网发送，不影响本地录制。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="AddExclusionRuleButton"
                                    Grid.Column="1"
                                    Click="OnAddExclusionRule"
                                    AutomationProperties.AutomationId="AddExclusionRuleButton"
                                    AutomationProperties.Name="添加不发送规则"
                                    IsEnabled="{x:Bind ViewModel.CanAddExclusionRule, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="添加排除规则">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Add" />
                                        <TextBlock Text="添加规则" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <InfoBar
                                x:Name="ExclusionRuleMutationInfoBar"
                                Grid.Row="1"
                                Margin="20,0,20,16"
                                AutomationProperties.LiveSetting="Polite"
                                Closed="OnExclusionRuleMutationInfoBarClosed"
                                IsOpen="False"
                                Severity="Success"
                                Title="排除规则已更新" />

                            <Border
                                Grid.Row="2"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0">
                                <Grid>
                                    <controls:EmptyStateControl
                                        x:Name="ExclusionRuleEmptyState"
                                        Margin="20,32"
                                        Description="启用的规则会阻止匹配证据发送给供应商，本地截图仍会继续保存。"
                                        Icon="BlockContact"
                                        Title="尚未添加不发送规则" />

                                    <ListView
                                        x:Name="ExclusionRuleList"
                                        AutomationProperties.AutomationId="ExclusionRuleList"
                                        AutomationProperties.Name="不发送规则"
                                        IsItemClickEnabled="False"
                                        IsEnabled="{x:Bind ViewModel.CanChangeExclusionRules, Mode=OneWay}"
                                        ItemsSource="{x:Bind ViewModel.ExclusionRules, Mode=OneWay}"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollMode="Disabled"
                                        SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="IsTabStop" Value="False" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="presentation:ExclusionRuleItemViewModel">
                                            <ContentControl
                                                x:Name="ExclusionRuleRowRoot"
                                                HorizontalContentAlignment="Stretch"
                                                IsTabStop="False"
                                                Loaded="OnExclusionRuleRowLoaded">
                                                <Grid
                                                    x:Name="ExclusionRuleRowGrid"
                                                    Padding="16"
                                                    ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel x:Name="ExclusionRuleContentStack" Spacing="3">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind Name, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind ConfiguredMatchSummaryText, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Style="{StaticResource MetadataTextStyle}"
                                                            Text="{x:Bind StatusText, Mode=OneWay}" />
                                                    </StackPanel>
                                                    <Grid
                                                        x:Name="ExclusionRuleActionPanel"
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <StackPanel
                                                            x:Name="ExclusionRuleStateActionPanel"
                                                            HorizontalAlignment="Right"
                                                            Orientation="Horizontal"
                                                            Spacing="4">
                                                            <ToggleSwitch
                                                                Width="48"
                                                                Height="40"
                                                                AutomationProperties.AutomationId="{x:Bind ToggleAutomationId, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind ToggleAutomationName, Mode=OneWay}"
                                                                IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                                                OffContent=""
                                                                OnContent=""
                                                                Toggled="OnExclusionRuleToggled"
                                                                ToolTipService.ToolTip="启用或停用规则" />
                                                            <Button
                                                                x:Name="MoveExclusionRuleUpButton"
                                                                Width="40"
                                                                Height="40"
                                                                Padding="0"
                                                                Click="OnMoveExclusionRuleUp"
                                                                AutomationProperties.AutomationId="{x:Bind MoveUpAutomationId, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind MoveUpAutomationName, Mode=OneWay}"
                                                                IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}"
                                                                ToolTipService.ToolTip="上移">
                                                                <FontIcon FontSize="16" Glyph="&#xE70E;" />
                                                            </Button>
                                                            <Button
                                                                x:Name="MoveExclusionRuleDownButton"
                                                                Width="40"
                                                                Height="40"
                                                                Padding="0"
                                                                Click="OnMoveExclusionRuleDown"
                                                                AutomationProperties.AutomationId="{x:Bind MoveDownAutomationId, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind MoveDownAutomationName, Mode=OneWay}"
                                                                IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}"
                                                                ToolTipService.ToolTip="下移">
                                                                <FontIcon FontSize="16" Glyph="&#xE70D;" />
                                                            </Button>
                                                        </StackPanel>
                                                        <StackPanel
                                                            x:Name="ExclusionRuleEditActionPanel"
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            Orientation="Horizontal"
                                                            Spacing="4">
                                                            <Button
                                                                x:Name="EditExclusionRuleButton"
                                                                Width="40"
                                                                Height="40"
                                                                Padding="0"
                                                                Click="OnEditExclusionRule"
                                                                AutomationProperties.AutomationId="{x:Bind EditAutomationId, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind EditAutomationName, Mode=OneWay}"
                                                                ToolTipService.ToolTip="编辑">
                                                                <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                                            </Button>
                                                            <Button
                                                                Width="40"
                                                                Height="40"
                                                                Padding="0"
                                                                Click="OnDeleteExclusionRule"
                                                                AutomationProperties.AutomationId="{x:Bind DeleteAutomationId, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind DeleteAutomationName, Mode=OneWay}"
                                                                ToolTipService.ToolTip="删除">
                                                                <FontIcon FontSize="16" Glyph="&#xE74D;" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </ContentControl>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                </StackPanel>

                <StackPanel x:Name="ProviderSection" Spacing="12" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="供应商" />

                    <InfoBar
                        x:Name="ProviderRoutingInfoBar"
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="False"
                        IsOpen="False" />

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid
                                x:Name="ProviderHeaderLayout"
                                Padding="20"
                                ColumnSpacing="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Spacing="3">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="OpenAI-compatible 供应商" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="每个处理阶段可独立选择供应商；创建配置不会自动启用联网。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="AddProviderButton"
                                    Grid.Column="1"
                                    Height="40"
                                    Click="OnAddProvider"
                                    IsEnabled="{x:Bind RoutingViewModel.CanMutate, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Add" />
                                        <TextBlock Text="新增" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Grid
                                Grid.Row="1"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0">
                                <controls:EmptyStateControl
                                    x:Name="ProviderEmptyState"
                                    Margin="20,32"
                                    Description="新增一个标准 API 配置后，再到“隐私与处理”分配阶段。"
                                    Icon="Globe"
                                    Title="尚未配置供应商" />
                                <ListView
                                    x:Name="ProviderList"
                                    ItemsSource="{x:Bind RoutingViewModel.Profiles, Mode=OneWay}"
                                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                    ScrollViewer.VerticalScrollMode="Disabled"
                                    SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="IsTabStop" Value="False" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="presentation:AiProviderProfileItemViewModel">
                                            <Grid Padding="16" ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" MinWidth="0" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Width="40"
                                                    Height="40"
                                                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                    CornerRadius="4">
                                                    <FontIcon FontSize="18" Glyph="&#xE774;" />
                                                </Border>
                                                <StackPanel
                                                    Grid.Column="1"
                                                    MinWidth="0"
                                                    VerticalAlignment="Center"
                                                    Spacing="2">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{x:Bind DisplayName}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                        Text="{x:Bind EndpointSummary}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Style="{StaticResource MetadataTextStyle}"
                                                        Text="{x:Bind ValidationSummary}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Style="{StaticResource MetadataTextStyle}"
                                                        Text="{x:Bind ConcurrencySummary}" />
                                                </StackPanel>
                                                <StackPanel
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                                    <Button
                                                        Width="40"
                                                        Height="40"
                                                        Padding="0"
                                                        Click="OnEditProvider"
                                                        AutomationProperties.Name="编辑供应商"
                                                        ToolTipService.ToolTip="编辑">
                                                        <FontIcon FontSize="16" Glyph="&#xE70F;" />
                                                    </Button>
                                                    <Button
                                                        Width="40"
                                                        Height="40"
                                                        Padding="0"
                                                        AutomationProperties.Name="更多供应商操作"
                                                        ToolTipService.ToolTip="更多操作">
                                                        <FontIcon FontSize="16" Glyph="&#xE712;" />
                                                        <Button.Flyout>
                                                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                <MenuFlyoutItem
                                                                    Click="OnValidateProviderPrivacy"
                                                                    Tag="{x:Bind Id}"
                                                                    Text="验证隐私检查">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <FontIcon Glyph="&#xE72E;" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutItem
                                                                    Click="OnValidateProviderTimeline"
                                                                    Tag="{x:Bind Id}"
                                                                    Text="验证时间线分析">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <SymbolIcon Symbol="Sync" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                                <MenuFlyoutSeparator />
                                                                <MenuFlyoutItem
                                                                    Click="OnDeleteProvider"
                                                                    Tag="{x:Bind Id}"
                                                                    Text="删除供应商">
                                                                    <MenuFlyoutItem.Icon>
                                                                        <SymbolIcon Symbol="Delete" />
                                                                    </MenuFlyoutItem.Icon>
                                                                </MenuFlyoutItem>
                                                            </MenuFlyout>
                                                        </Button.Flyout>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Grid>
                        </Grid>
                    </Border>

                </StackPanel>

                <StackPanel x:Name="AboutSection" Spacing="12" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="关于" />
                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <StackPanel Padding="20" Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="WinDayFlow" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="更‘Windows’的原生 DayFlow 体验"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="AppVersionTextBlock"
                                    Style="{StaticResource MetadataTextStyle}"
                                    Text="版本" />
                            </StackPanel>
                            <TextBlock
                                Style="{StaticResource MetadataTextStyle}"
                                Text="原始证据保存在本机；是否发送、如何处理以及使用哪个供应商由你决定。"
                                TextWrapping="Wrap" />
                            <StackPanel Spacing="2">
                                <TextBlock
                                    Margin="0,4,0,2"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="项目与参考" />
                                <HyperlinkButton
                                    Padding="0,6"
                                    NavigateUri="https://github.com/timeStarry/WinDayFlow">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE71B;" />
                                        <TextBlock Text="WinDayFlow · GitHub 仓库" />
                                    </StackPanel>
                                </HyperlinkButton>
                                <HyperlinkButton
                                    Padding="0,6"
                                    NavigateUri="https://github.com/JerryZLiu/Dayflow">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE71B;" />
                                        <TextBlock Text="Dayflow · 原始产品参考" />
                                    </StackPanel>
                                </HyperlinkButton>
                                <HyperlinkButton
                                    Padding="0,6"
                                    NavigateUri="https://github.com/liujiaqi7998/QiDayflow">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="16" Glyph="&#xE71B;" />
                                        <TextBlock Text="QiDayflow · Windows 实现参考" />
                                    </StackPanel>
                                </HyperlinkButton>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        </NavigationView>

        <ContentDialog
            x:Name="ProviderEditorDialog"
            AutomationProperties.Name="供应商配置编辑器"
            DefaultButton="Primary"
            PrimaryButtonClick="OnProviderEditorPrimaryButtonClick"
            PrimaryButtonText="保存"
            SecondaryButtonText="取消">
            <ScrollViewer
                MaxHeight="620"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="520" Spacing="16">
                    <InfoBar
                        x:Name="ProviderEditorErrorInfoBar"
                        AutomationProperties.LiveSetting="Assertive"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Error"
                        Title="请检查供应商配置" />
                    <TextBox
                        x:Name="ProviderEditorNameTextBox"
                        Header="名称"
                        MaxLength="80"
                        PlaceholderText="例如：OpenAI 或本机 LM Studio" />
                    <TextBox
                        x:Name="ProviderEditorEndpointTextBox"
                        Header="API 基础地址"
                        MaxLength="4096"
                        PlaceholderText="https://api.openai.com/v1/" />
                    <TextBox
                        x:Name="ProviderEditorModelTextBox"
                        Header="视觉模型"
                        MaxLength="200"
                        PlaceholderText="输入支持图像与结构化输出的模型名称" />
                    <NumberBox
                        x:Name="ProviderEditorTimeoutNumberBox"
                        MaxWidth="240"
                        HorizontalAlignment="Left"
                        Header="请求超时（秒）"
                        LargeChange="30"
                        Maximum="600"
                        Minimum="10"
                        SmallChange="10"
                        SpinButtonPlacementMode="Compact"
                        Value="60" />
                    <NumberBox
                        x:Name="ProviderEditorConcurrencyNumberBox"
                        MaxWidth="240"
                        HorizontalAlignment="Left"
                        Header="后台最大并发"
                        Maximum="16"
                        Minimum="1"
                        SmallChange="1"
                        SpinButtonPlacementMode="Compact"
                        Value="1" />
                    <PasswordBox
                        x:Name="ProviderEditorApiKeyPasswordBox"
                        Header="API 密钥"
                        MaxLength="8192"
                        PasswordRevealMode="Peek"
                        PlaceholderText="编辑时留空可保留已保存密钥" />
                    <CheckBox
                        x:Name="ProviderEditorClearApiKeyCheckBox"
                        Content="清除已保存的 API 密钥" />
                    <TextBlock
                        Style="{StaticResource MetadataTextStyle}"
                        Text="远程地址仅允许 HTTPS；本机回环地址可使用 HTTP。密钥使用当前 Windows 用户的 DPAPI 加密。"
                        TextWrapping="Wrap" />
                    <ProgressBar
                        x:Name="ProviderEditorProgressBar"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>

        <ContentDialog
            x:Name="ExclusionRuleEditorDialog"
            AutomationProperties.Name="不发送规则编辑器"
            DefaultButton="Primary"
            PrimaryButtonClick="OnExclusionRuleEditorPrimaryButtonClick"
            PrimaryButtonText="保存"
            SecondaryButtonText="取消">
            <ScrollViewer
                MaxHeight="600"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ExclusionRuleEditorForm" MaxWidth="520" Spacing="16">
                    <InfoBar
                        x:Name="ExclusionRuleEditorErrorInfoBar"
                        AutomationProperties.LiveSetting="Assertive"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Error"
                        Title="请检查规则信息" />

                    <TextBox
                        x:Name="ExclusionRuleNameTextBox"
                        AutomationProperties.AutomationId="ExclusionRuleName"
                        AutomationProperties.Name="规则名称"
                        Header="名称"
                        MaxLength="80"
                        PlaceholderText="例如：密码管理器" />

                    <ComboBox
                        x:Name="ExclusionRuleScopePicker"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="ExclusionRuleScope"
                        AutomationProperties.Name="排除范围"
                        Header="排除范围"
                        SelectionChanged="OnExclusionRuleEditorSelectionChanged">
                        <ComboBoxItem Content="整个应用" Tag="Application" />
                        <ComboBoxItem Content="特定窗口" Tag="Window" />
                    </ComboBox>

                    <ComboBox
                        x:Name="ExclusionRuleIdentityKindPicker"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="ExclusionRuleIdentityKind"
                        AutomationProperties.Name="应用身份类型"
                        Header="应用身份类型"
                        SelectionChanged="OnExclusionRuleEditorSelectionChanged">
                        <ComboBoxItem Content="EXE 文件名" Tag="ExecutableName" />
                        <ComboBoxItem Content="包系列名称 (PFN)" Tag="PackageFamilyName" />
                        <ComboBoxItem Content="发布者证书 SHA-256" Tag="PublisherCertificateSha256" />
                    </ComboBox>

                    <StackPanel Spacing="6">
                        <TextBox
                            x:Name="ExclusionRuleIdentityTextBox"
                            AutomationProperties.AutomationId="ExclusionRuleIdentity"
                            AutomationProperties.Name="应用身份"
                            Header="可执行文件名"
                            MaxLength="512"
                            PlaceholderText="例如：KeePassXC.exe" />
                        <TextBlock
                            x:Name="ExclusionRuleIdentityHelpText"
                            Style="{StaticResource MetadataTextStyle}"
                            Text="只接受 EXE 文件名，不接受完整路径。"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="ExclusionRuleWindowMatchPanel" Spacing="16">
                        <ComboBox
                            x:Name="ExclusionRuleWindowMatchKindPicker"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="ExclusionRuleWindowMatchKind"
                            AutomationProperties.Name="窗口标题匹配方式"
                            Header="窗口标题匹配方式">
                            <ComboBoxItem Content="完全匹配" Tag="Exact" />
                            <ComboBoxItem Content="开头匹配" Tag="StartsWith" />
                            <ComboBoxItem Content="包含" Tag="Contains" />
                        </ComboBox>
                        <TextBox
                            x:Name="ExclusionRuleWindowPatternTextBox"
                            AutomationProperties.AutomationId="ExclusionRuleWindowPattern"
                            AutomationProperties.Name="窗口标题匹配文字"
                            Header="匹配文字"
                            MaxLength="256"
                            PlaceholderText="输入要匹配的文字" />
                        <TextBlock
                            Style="{StaticResource MetadataTextStyle}"
                            Text="这里只保存你输入的匹配文字。此页面不会读取、列出或预览当前窗口标题。"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="ExclusionRuleEnabledToggle"
                        AutomationProperties.AutomationId="ExclusionRuleEnabled"
                        AutomationProperties.Name="保存后启用规则"
                        Header="保存后启用规则"
                        OffContent="停用"
                        OnContent="启用" />

                    <TextBlock
                        Style="{StaticResource MetadataTextStyle}"
                        Text="启用规则只会阻止匹配证据联网发送，不会停止或暂停本地录制。"
                        TextWrapping="Wrap" />

                    <ProgressBar
                        x:Name="ExclusionRuleEditorProgressBar"
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="正在保存排除规则"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
