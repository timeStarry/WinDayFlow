<Page
    x:Class="WinDayFlow.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:WinDayFlow.App.Controls"
    xmlns:presentation="using:WinDayFlow.Presentation.Settings">
    <Grid>
        <ScrollViewer
            Padding="{StaticResource PagePadding}"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="{StaticResource SettingsContentMaxWidth}"
                HorizontalAlignment="Center"
                Spacing="28">
                <InfoBar
                    x:Name="SettingsErrorInfoBar"
                    AutomationProperties.LiveSetting="Assertive"
                    IsClosable="False"
                    Severity="Error"
                    Title="无法完成设置操作" />

                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="外观" />
                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid
                            x:Name="ThemeSettingLayout"
                            Padding="20"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="应用主题" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="选择 WinDayFlow 如何跟随 Windows 外观。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="ThemePicker"
                                Grid.Column="1"
                                MaxWidth="260"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ThemePicker"
                                AutomationProperties.Name="应用主题"
                                SelectionChanged="OnThemeChanged">
                                <ComboBoxItem Content="使用系统设置" Tag="System" />
                                <ComboBoxItem Content="浅色" Tag="Light" />
                                <ComboBoxItem Content="深色" Tag="Dark" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="录制" />
                    <InfoBar
                        x:Name="CaptureInfoBar"
                        IsClosable="False"
                        IsOpen="True"
                        Message="{x:Bind ViewModel.CaptureAvailabilityText, Mode=OneWay}"
                        Severity="Informational"
                        Title="录制状态" />

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid
                            x:Name="ConsentSettingLayout"
                            Padding="20"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="录制授权" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.ConsentStatusText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Style="{StaticResource MetadataTextStyle}"
                                    Text="{x:Bind ViewModel.ConsentDetailText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel
                                x:Name="ConsentActionPanel"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="GrantConsentButton"
                                    Click="OnGrantConsent"
                                    AutomationProperties.AutomationId="GrantRecordingConsentButton"
                                    AutomationProperties.Name="查看录制说明并同意"
                                    IsEnabled="{x:Bind ViewModel.CanGrantConsent, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <TextBlock Text="查看并同意" TextWrapping="NoWrap" />
                                </Button>
                                <Button
                                    x:Name="RevokeConsentButton"
                                    Click="OnRevokeConsent"
                                    AutomationProperties.AutomationId="RevokeRecordingConsentButton"
                                    AutomationProperties.Name="撤回录制同意"
                                    IsEnabled="{x:Bind ViewModel.CanRevokeConsent, Mode=OneWay}">
                                    <TextBlock Text="撤回同意" TextWrapping="NoWrap" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid
                            x:Name="CaptureSettingLayout"
                            Padding="20"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="记录屏幕活动" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="启用后，活动证据会保存在本机并用于生成时间线。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="CaptureToggle"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="CaptureToggle"
                                AutomationProperties.Name="记录屏幕活动"
                                IsEnabled="{x:Bind ViewModel.CanChangeCapture, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.CaptureEnabled, Mode=OneWay}"
                                OffContent="关闭"
                                OnContent="开启"
                                Toggled="OnCaptureToggled" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid
                            x:Name="CaptureIntervalSettingLayout"
                            Padding="20"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="截屏间隔" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="较长间隔占用更少本地空间，也会减少分析图片数量。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="CaptureIntervalPicker"
                                Grid.Column="1"
                                MaxWidth="260"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="CaptureIntervalPicker"
                                AutomationProperties.Name="截屏间隔"
                                IsEnabled="{x:Bind ViewModel.CanChangeCaptureInterval, Mode=OneWay}"
                                SelectionChanged="OnCaptureIntervalChanged">
                                <ComboBoxItem Content="5 秒" Tag="5" />
                                <ComboBoxItem Content="10 秒" Tag="10" />
                                <ComboBoxItem Content="15 秒" Tag="15" />
                                <ComboBoxItem Content="30 秒" Tag="30" />
                                <ComboBoxItem Content="60 秒" Tag="60" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="存储" />
                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid
                            x:Name="StorageSettingLayout"
                            Padding="20"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="本地数据目录" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="时间线、授权记录和设置保存在当前用户目录。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBox
                                x:Name="DataFolderTextBox"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="DataFolderPath"
                                AutomationProperties.Name="本地数据目录"
                                IsReadOnly="True" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid
                            x:Name="RetentionSettingLayout"
                            Padding="20"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="屏幕证据保留期限" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="到期证据将在没有待处理任务引用时进入清理队列。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ComboBox
                                x:Name="RetentionPicker"
                                Grid.Column="1"
                                MaxWidth="260"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="EvidenceRetentionPicker"
                                AutomationProperties.Name="屏幕证据保留期限"
                                IsEnabled="{x:Bind ViewModel.CanChangePrivacy, Mode=OneWay}"
                                SelectionChanged="OnRetentionChanged">
                                <ComboBoxItem Content="7 天" Tag="7" />
                                <ComboBoxItem Content="30 天" Tag="30" />
                                <ComboBoxItem Content="90 天" Tag="90" />
                                <ComboBoxItem Content="1 年" Tag="365" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="隐私" />
                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid
                            x:Name="ApplicationPrivacyModeSettingLayout"
                            Padding="20"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="应用录制范围" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.ApplicationPrivacyModeDetailText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <RadioButtons
                                x:Name="ApplicationPrivacyModePicker"
                                Grid.Column="1"
                                MaxWidth="420"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ApplicationPrivacyModePicker"
                                AutomationProperties.Name="应用录制范围"
                                IsEnabled="{x:Bind ViewModel.CanChangeApplicationPrivacyMode, Mode=OneWay}"
                                SelectionChanged="OnApplicationPrivacyModeChanged">
                                <x:String>按前台应用保护（隐私优先）</x:String>
                                <x:String>固定一个显示器，允许其中全部应用（连续性优先）</x:String>
                            </RadioButtons>
                        </Grid>
                    </Border>

                    <InfoBar
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="False"
                        IsOpen="{x:Bind ViewModel.IsAllowAllApplicationsMode, Mode=OneWay}"
                        Message="{x:Bind ViewModel.ContinuousCaptureDisclosureText, Mode=OneWay}"
                        Severity="Warning"
                        Title="固定显示器连续录制会扩大采集范围" />

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid
                            x:Name="SensitiveApplicationSettingLayout"
                            Padding="20"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="敏感应用保护" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.SensitiveApplicationProtectionDetailText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="SensitiveApplicationToggle"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="SensitiveApplicationProtectionToggle"
                                AutomationProperties.Name="敏感应用保护"
                                IsEnabled="{x:Bind ViewModel.CanChangeApplicationProtection, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.ExcludeSensitiveApplications, Mode=OneWay}"
                                OffContent="关闭"
                                OnContent="排除"
                                Toggled="OnPrivacyToggleChanged" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid
                                x:Name="ExclusionRulesHeaderLayout"
                                Padding="20"
                                ColumnSpacing="24">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                    <TextBlock
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="应用和窗口排除" />
                                    <TextBlock
                                        x:Name="ExclusionRuleSummaryTextBlock"
                                        AutomationProperties.LiveSetting="Polite"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="没有自定义规则"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="ExclusionRuleAvailabilityTextBlock"
                                        Style="{StaticResource MetadataTextStyle}"
                                        Text="规则已保存到本机，尚未接入录制监视器；当前不会用于录制。"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="AddExclusionRuleButton"
                                    Grid.Column="1"
                                    Click="OnAddExclusionRule"
                                    AutomationProperties.AutomationId="AddExclusionRuleButton"
                                    AutomationProperties.Name="添加应用或窗口排除规则"
                                    IsEnabled="{x:Bind ViewModel.CanAddExclusionRule, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    ToolTipService.ToolTip="添加排除规则">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Add" />
                                        <TextBlock Text="添加规则" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <InfoBar
                                x:Name="ExclusionRuleMutationInfoBar"
                                Grid.Row="1"
                                Margin="20,0,20,16"
                                AutomationProperties.LiveSetting="Polite"
                                Closed="OnExclusionRuleMutationInfoBarClosed"
                                IsOpen="False"
                                Severity="Success"
                                Title="排除规则已更新" />

                            <Border
                                Grid.Row="2"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0">
                                <Grid>
                                    <controls:EmptyStateControl
                                        x:Name="ExclusionRuleEmptyState"
                                        Margin="20,32"
                                        Description="添加规则不会开启录制；录制组件接入后，启用的规则才会阻止匹配内容。"
                                        Icon="BlockContact"
                                        Title="尚未添加自定义排除规则" />

                                    <ListView
                                        x:Name="ExclusionRuleList"
                                        AutomationProperties.AutomationId="ExclusionRuleList"
                                        AutomationProperties.Name="应用和窗口排除规则"
                                        IsItemClickEnabled="False"
                                        IsEnabled="{x:Bind ViewModel.CanChangeExclusionRules, Mode=OneWay}"
                                        ItemsSource="{x:Bind ViewModel.ExclusionRules, Mode=OneWay}"
                                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                        ScrollViewer.VerticalScrollMode="Disabled"
                                        SelectionMode="None">
                                    <ListView.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="IsTabStop" Value="False" />
                                            <Setter Property="Padding" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="presentation:ExclusionRuleItemViewModel">
                                            <ContentControl
                                                x:Name="ExclusionRuleRowRoot"
                                                HorizontalContentAlignment="Stretch"
                                                IsTabStop="False"
                                                Loaded="OnExclusionRuleRowLoaded">
                                                <Grid
                                                    x:Name="ExclusionRuleRowGrid"
                                                    Padding="16"
                                                    ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <StackPanel x:Name="ExclusionRuleContentStack" Spacing="3">
                                                        <TextBlock
                                                            FontWeight="SemiBold"
                                                            Text="{x:Bind Name, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis" />
                                                        <TextBlock
                                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                            Text="{x:Bind ConfiguredMatchSummaryText, Mode=OneWay}"
                                                            TextTrimming="CharacterEllipsis"
                                                            TextWrapping="Wrap" />
                                                        <TextBlock
                                                            Style="{StaticResource MetadataTextStyle}"
                                                            Text="{x:Bind StatusText, Mode=OneWay}" />
                                                    </StackPanel>
                                                    <Grid
                                                        x:Name="ExclusionRuleActionPanel"
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <StackPanel
                                                            x:Name="ExclusionRuleStateActionPanel"
                                                            HorizontalAlignment="Right"
                                                            Orientation="Horizontal"
                                                            Spacing="4">
                                                            <ToggleSwitch
                                                                Width="48"
                                                                Height="40"
                                                                AutomationProperties.AutomationId="{x:Bind ToggleAutomationId, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind ToggleAutomationName, Mode=OneWay}"
                                                                IsOn="{x:Bind IsEnabled, Mode=OneWay}"
                                                                OffContent=""
                                                                OnContent=""
                                                                Toggled="OnExclusionRuleToggled"
                                                                ToolTipService.ToolTip="启用或停用规则" />
                                                            <Button
                                                                x:Name="MoveExclusionRuleUpButton"
                                                                Width="40"
                                                                Height="40"
                                                                Click="OnMoveExclusionRuleUp"
                                                                AutomationProperties.AutomationId="{x:Bind MoveUpAutomationId, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind MoveUpAutomationName, Mode=OneWay}"
                                                                IsEnabled="{x:Bind CanMoveUp, Mode=OneWay}"
                                                                ToolTipService.ToolTip="上移">
                                                                <FontIcon Glyph="&#xE70E;" />
                                                            </Button>
                                                            <Button
                                                                x:Name="MoveExclusionRuleDownButton"
                                                                Width="40"
                                                                Height="40"
                                                                Click="OnMoveExclusionRuleDown"
                                                                AutomationProperties.AutomationId="{x:Bind MoveDownAutomationId, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind MoveDownAutomationName, Mode=OneWay}"
                                                                IsEnabled="{x:Bind CanMoveDown, Mode=OneWay}"
                                                                ToolTipService.ToolTip="下移">
                                                                <FontIcon Glyph="&#xE70D;" />
                                                            </Button>
                                                        </StackPanel>
                                                        <StackPanel
                                                            x:Name="ExclusionRuleEditActionPanel"
                                                            Grid.Column="1"
                                                            HorizontalAlignment="Right"
                                                            Orientation="Horizontal"
                                                            Spacing="4">
                                                            <Button
                                                                x:Name="EditExclusionRuleButton"
                                                                Width="40"
                                                                Height="40"
                                                                Click="OnEditExclusionRule"
                                                                AutomationProperties.AutomationId="{x:Bind EditAutomationId, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind EditAutomationName, Mode=OneWay}"
                                                                ToolTipService.ToolTip="编辑">
                                                                <SymbolIcon Symbol="Edit" />
                                                            </Button>
                                                            <Button
                                                                Width="40"
                                                                Height="40"
                                                                Click="OnDeleteExclusionRule"
                                                                AutomationProperties.AutomationId="{x:Bind DeleteAutomationId, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind DeleteAutomationName, Mode=OneWay}"
                                                                ToolTipService.ToolTip="删除">
                                                                <SymbolIcon Symbol="Delete" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </ContentControl>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    </ListView>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid
                            x:Name="RemoteSessionSettingLayout"
                            Padding="20"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="远程会话" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="录制组件接入后，连接远程桌面或进入远程会话时将使用保守暂停策略。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="RemoteSessionToggle"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="RemoteSessionPauseToggle"
                                AutomationProperties.Name="远程会话期间暂停"
                                IsEnabled="{x:Bind ViewModel.CanChangePrivacy, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.PauseInRemoteSessions, Mode=OneWay}"
                                OffContent="继续"
                                OnContent="暂停"
                                Toggled="OnPrivacyToggleChanged" />
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid
                            x:Name="ScreenSharingSettingLayout"
                            Padding="20"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Windows 演示模式" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="录制组件接入后，进入 Windows 演示模式时将暂停；其他屏幕共享应用尚不能通用检测。"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="ScreenSharingToggle"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="ScreenSharingPauseToggle"
                                AutomationProperties.Name="Windows 演示模式期间暂停"
                                IsEnabled="{x:Bind ViewModel.CanChangePrivacy, Mode=OneWay}"
                                IsOn="{x:Bind ViewModel.PauseDuringScreenSharing, Mode=OneWay}"
                                OffContent="继续"
                                OnContent="暂停"
                                Toggled="OnPrivacyToggleChanged" />
                        </Grid>
                    </Border>

                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="AI 分析" />

                    <InfoBar
                        x:Name="AiProviderInfoBar"
                        AutomationProperties.LiveSetting="Polite"
                        IsClosable="False"
                        IsOpen="True"
                        Severity="Informational"
                        Title="分析提供方" />

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <StackPanel Padding="20" Spacing="16">
                            <StackPanel Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="OpenAI-compatible 提供方" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="配置保存到本机；远程地址只允许 HTTPS，本机回环地址可以使用 HTTP。"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBox
                                x:Name="AiProviderNameTextBox"
                                AutomationProperties.AutomationId="AiProviderDisplayName"
                                AutomationProperties.Name="分析提供方名称"
                                Header="名称"
                                MaxLength="80"
                                PlaceholderText="例如：OpenAI 或本机 LM Studio" />

                            <TextBox
                                x:Name="AiProviderEndpointTextBox"
                                AutomationProperties.AutomationId="AiProviderEndpoint"
                                AutomationProperties.Name="API 基础地址"
                                Header="API 基础地址"
                                MaxLength="2048"
                                PlaceholderText="https://api.openai.com/v1/" />

                            <TextBox
                                x:Name="AiProviderModelTextBox"
                                AutomationProperties.AutomationId="AiProviderModel"
                                AutomationProperties.Name="视觉模型"
                                Header="视觉模型"
                                MaxLength="200"
                                PlaceholderText="输入支持图像与结构化输出的模型名称" />

                            <NumberBox
                                x:Name="AiProviderTimeoutNumberBox"
                                MaxWidth="240"
                                HorizontalAlignment="Left"
                                AutomationProperties.AutomationId="AiProviderTimeout"
                                AutomationProperties.Name="请求超时秒数"
                                Header="请求超时（秒）"
                                LargeChange="30"
                                Maximum="600"
                                Minimum="10"
                                SmallChange="10"
                                SpinButtonPlacementMode="Compact"
                                Value="60" />

                            <PasswordBox
                                x:Name="AiProviderApiKeyPasswordBox"
                                AutomationProperties.AutomationId="AiProviderApiKey"
                                AutomationProperties.HelpText="保存后不会再次显示；留空将保留已保存密钥"
                                AutomationProperties.Name="API 密钥"
                                Header="API 密钥"
                                MaxLength="8192"
                                PasswordRevealMode="Peek"
                                PlaceholderText="留空以保留已保存密钥" />

                            <CheckBox
                                x:Name="ClearAiProviderApiKeyCheckBox"
                                AutomationProperties.AutomationId="ClearAiProviderApiKey"
                                AutomationProperties.Name="清除已保存的 API 密钥"
                                Content="清除已保存的 API 密钥" />

                            <StackPanel Spacing="4">
                                <TextBlock
                                    x:Name="AiCredentialStatusText"
                                    Style="{StaticResource MetadataTextStyle}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="AiValidationStatusText"
                                    Style="{StaticResource MetadataTextStyle}"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="SaveAiProviderButton"
                                    Click="OnSaveAiProvider"
                                    AutomationProperties.AutomationId="SaveAiProviderButton"
                                    AutomationProperties.Name="保存分析提供方配置"
                                    IsEnabled="{x:Bind AiViewModel.CanSave, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Save" />
                                        <TextBlock Text="保存配置" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="TestAiProviderButton"
                                    Click="OnTestAiProvider"
                                    AutomationProperties.AutomationId="TestAiProviderButton"
                                    AutomationProperties.HelpText="只发送应用生成的合成图像，不发送录制证据"
                                    AutomationProperties.Name="测试分析提供方连接"
                                    IsEnabled="{x:Bind AiViewModel.CanTestConnection, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Sync" />
                                        <TextBlock Text="测试连接" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <ProgressBar
                                x:Name="AiProviderProgressBar"
                                AutomationProperties.LiveSetting="Polite"
                                AutomationProperties.Name="正在更新分析提供方"
                                IsIndeterminate="True"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SettingsGroupBorderStyle}">
                        <Grid
                            x:Name="CloudSettingLayout"
                            Padding="20"
                            ColumnSpacing="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="允许云端分析" />
                                <TextBlock
                                    x:Name="CloudAnalysisStatusText"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="CloudAnalysisToggle"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="CloudAnalysisToggle"
                                AutomationProperties.HelpText="启用前必须保存并验证当前分析提供方"
                                AutomationProperties.Name="允许云端分析"
                                IsEnabled="{x:Bind AiViewModel.CanChangeCloudAnalysis, Mode=OneWay}"
                                IsOn="{x:Bind AiViewModel.CloudAnalysisEnabled, Mode=OneWay}"
                                OffContent="仅本地"
                                OnContent="已启用"
                                Toggled="OnCloudAnalysisToggled" />
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <ContentDialog
            x:Name="ExclusionRuleEditorDialog"
            AutomationProperties.Name="排除规则编辑器"
            DefaultButton="Primary"
            PrimaryButtonClick="OnExclusionRuleEditorPrimaryButtonClick"
            PrimaryButtonText="保存"
            SecondaryButtonText="取消">
            <ScrollViewer
                MaxHeight="600"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ExclusionRuleEditorForm" MaxWidth="520" Spacing="16">
                    <InfoBar
                        x:Name="ExclusionRuleEditorErrorInfoBar"
                        AutomationProperties.LiveSetting="Assertive"
                        IsClosable="False"
                        IsOpen="False"
                        Severity="Error"
                        Title="请检查规则信息" />

                    <TextBox
                        x:Name="ExclusionRuleNameTextBox"
                        AutomationProperties.AutomationId="ExclusionRuleName"
                        AutomationProperties.Name="规则名称"
                        Header="名称"
                        MaxLength="80"
                        PlaceholderText="例如：密码管理器" />

                    <ComboBox
                        x:Name="ExclusionRuleScopePicker"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="ExclusionRuleScope"
                        AutomationProperties.Name="排除范围"
                        Header="排除范围"
                        SelectionChanged="OnExclusionRuleEditorSelectionChanged">
                        <ComboBoxItem Content="整个应用" Tag="Application" />
                        <ComboBoxItem Content="特定窗口" Tag="Window" />
                    </ComboBox>

                    <ComboBox
                        x:Name="ExclusionRuleIdentityKindPicker"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="ExclusionRuleIdentityKind"
                        AutomationProperties.Name="应用身份类型"
                        Header="应用身份类型"
                        SelectionChanged="OnExclusionRuleEditorSelectionChanged">
                        <ComboBoxItem Content="EXE 文件名" Tag="ExecutableName" />
                        <ComboBoxItem Content="包系列名称 (PFN)" Tag="PackageFamilyName" />
                        <ComboBoxItem Content="发布者证书 SHA-256" Tag="PublisherCertificateSha256" />
                    </ComboBox>

                    <StackPanel Spacing="6">
                        <TextBox
                            x:Name="ExclusionRuleIdentityTextBox"
                            AutomationProperties.AutomationId="ExclusionRuleIdentity"
                            AutomationProperties.Name="应用身份"
                            Header="可执行文件名"
                            MaxLength="512"
                            PlaceholderText="例如：KeePassXC.exe" />
                        <TextBlock
                            x:Name="ExclusionRuleIdentityHelpText"
                            Style="{StaticResource MetadataTextStyle}"
                            Text="只接受 EXE 文件名，不接受完整路径。"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel x:Name="ExclusionRuleWindowMatchPanel" Spacing="16">
                        <ComboBox
                            x:Name="ExclusionRuleWindowMatchKindPicker"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="ExclusionRuleWindowMatchKind"
                            AutomationProperties.Name="窗口标题匹配方式"
                            Header="窗口标题匹配方式">
                            <ComboBoxItem Content="完全匹配" Tag="Exact" />
                            <ComboBoxItem Content="开头匹配" Tag="StartsWith" />
                            <ComboBoxItem Content="包含" Tag="Contains" />
                        </ComboBox>
                        <TextBox
                            x:Name="ExclusionRuleWindowPatternTextBox"
                            AutomationProperties.AutomationId="ExclusionRuleWindowPattern"
                            AutomationProperties.Name="窗口标题匹配文字"
                            Header="匹配文字"
                            MaxLength="256"
                            PlaceholderText="输入要匹配的文字" />
                        <TextBlock
                            Style="{StaticResource MetadataTextStyle}"
                            Text="这里只保存你输入的匹配文字。此页面不会读取、列出或预览当前窗口标题。"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleSwitch
                        x:Name="ExclusionRuleEnabledToggle"
                        AutomationProperties.AutomationId="ExclusionRuleEnabled"
                        AutomationProperties.Name="保存后启用规则"
                        Header="保存后启用规则"
                        OffContent="停用"
                        OnContent="启用" />

                    <TextBlock
                        Style="{StaticResource MetadataTextStyle}"
                        Text="启用规则只会配置排除边界，不会开启录制。"
                        TextWrapping="Wrap" />

                    <ProgressBar
                        x:Name="ExclusionRuleEditorProgressBar"
                        AutomationProperties.LiveSetting="Polite"
                        AutomationProperties.Name="正在保存排除规则"
                        IsIndeterminate="True"
                        Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>
        </ContentDialog>
    </Grid>
</Page>
