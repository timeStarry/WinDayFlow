<Page
    x:Class="WinDayFlow.App.Views.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Transparent">
    <NavigationView
        x:Name="Navigation"
        AutomationProperties.AutomationId="PrimaryNavigation"
        Background="Transparent"
        CompactPaneLength="{StaticResource NavigationCompactPaneLength}"
        IsBackButtonVisible="Collapsed"
        IsPaneToggleButtonVisible="True"
        IsSettingsVisible="False"
        IsTitleBarAutoPaddingEnabled="False"
        Loaded="OnNavigationLoaded"
        OpenPaneLength="{StaticResource NavigationOpenPaneLength}"
        PaneDisplayMode="Auto"
        SelectionChanged="OnNavigationSelectionChanged"
        SizeChanged="OnNavigationSizeChanged">
        <NavigationView.Resources>
            <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            <Thickness x:Key="NavigationViewContentGridBorderThickness">0</Thickness>
            <CornerRadius x:Key="NavigationViewContentGridCornerRadius">0</CornerRadius>
            <Thickness x:Key="NavigationViewBorderThickness">0</Thickness>
            <Thickness x:Key="NavigationViewHeaderMargin">24,20,24,8</Thickness>
        </NavigationView.Resources>

        <NavigationView.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PageTitle"
                    AutomationProperties.AutomationId="PageTitle"
                    VerticalAlignment="Center"
                    Style="{StaticResource PageTitleTextStyle}"
                    Text="Timeline"
                    TextTrimming="CharacterEllipsis" />
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        Click="OnOpenCaptureSettings"
                        AutomationProperties.HelpText="{x:Bind ViewModel.CaptureStatus.DetailText, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.CaptureStatus.StatusText, Mode=OneWay}"
                        ToolTipService.ToolTip="打开录制设置">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <SymbolIcon Symbol="Video" />
                            <TextBlock
                                x:Name="CaptureStatusText"
                                AutomationProperties.LiveSetting="Polite"
                                Text="{x:Bind ViewModel.CaptureStatus.StatusText, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </NavigationView.Header>

        <NavigationView.MenuItems>
            <NavigationViewItemHeader Content="今天" />
            <NavigationViewItem
                x:Name="TimelineNavigationItem"
                AccessKey="T"
                Content="时间线"
                Tag="timeline">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Bullets" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem AccessKey="D" Content="日报" Tag="daily">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Calendar" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem AccessKey="J" Content="日志" Tag="journal">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Edit" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>

            <NavigationViewItemHeader Content="洞察" />
            <NavigationViewItem AccessKey="W" Content="周报" Tag="weekly">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="ViewAll" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem AccessKey="I" Content="统计" Tag="statistics">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="ViewAll" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
            <NavigationViewItem AccessKey="C" Content="问答" Tag="chat">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Message" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItemHeader Content="系统" />
            <NavigationViewItem
                x:Name="SettingsNavigationItem"
                AccessKey="S"
                Content="设置"
                Tag="settings">
                <NavigationViewItem.Icon>
                    <SymbolIcon Symbol="Setting" />
                </NavigationViewItem.Icon>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <Frame x:Name="ContentFrame" />
    </NavigationView>
</Page>
