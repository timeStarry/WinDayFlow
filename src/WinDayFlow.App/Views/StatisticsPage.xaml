<Page
    x:Class="WinDayFlow.App.Views.StatisticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:presentation="using:WinDayFlow.Presentation.Statistics"
    Loaded="OnLoaded"
    SizeChanged="OnSizeChanged"
    Unloaded="OnUnloaded">
    <ScrollViewer Padding="{StaticResource PagePadding}" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1040" HorizontalAlignment="Center" Spacing="28">
            <Grid Height="48" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <SelectorBar
                    x:Name="RangeSelector"
                    HorizontalAlignment="Left"
                    SelectionChanged="OnRangeChanged">
                    <SelectorBarItem x:Name="TodayRange" Text="今天" />
                    <SelectorBarItem x:Name="SevenDaysRange" Text="7 天" />
                    <SelectorBarItem x:Name="ThirtyDaysRange" Text="30 天" />
                    <SelectorBarItem x:Name="AllRange" Text="全部" />
                    <SelectorBarItem x:Name="CustomRange" Text="自定义" />
                </SelectorBar>
                <Button
                    x:Name="RangeSummaryButton"
                    Grid.Column="1"
                    Height="40"
                    MinWidth="160"
                    HorizontalAlignment="Right"
                    ToolTipService.ToolTip="选择日期范围">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Width="320" Spacing="16">
                                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="自定义日期范围" />
                                <CalendarDatePicker
                                    x:Name="StartDatePicker"
                                    HorizontalAlignment="Stretch"
                                    Header="开始日期"
                                    PlaceholderText="选择开始日期" />
                                <CalendarDatePicker
                                    x:Name="EndDatePicker"
                                    HorizontalAlignment="Stretch"
                                    Header="结束日期"
                                    PlaceholderText="选择结束日期" />
                                <Button
                                    HorizontalAlignment="Right"
                                    Click="OnApplyDateRange"
                                    Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <SymbolIcon Symbol="Accept" />
                                        <TextBlock Text="应用" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="16" Glyph="&#xE787;" />
                        <TextBlock x:Name="RangeSummaryText" Text="今天" />
                    </StackPanel>
                </Button>
                <Button
                    Grid.Column="2"
                    Width="40"
                    Height="40"
                    Padding="0"
                    Click="OnRefresh"
                    ToolTipService.ToolTip="刷新统计"
                    AutomationProperties.Name="刷新统计">
                    <FontIcon FontSize="16" Glyph="&#xE72C;" />
                </Button>
            </Grid>

            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}" IsClosable="False" Severity="Error" Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" />

            <Grid x:Name="SummaryGrid" ColumnSpacing="32" RowSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource MetadataTextStyle}" Text="陪伴工作时长" />
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{x:Bind ViewModel.RecordedDurationText, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Style="{StaticResource MetadataTextStyle}" Text="活跃天数" />
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{x:Bind ViewModel.ActiveDayCountText, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Style="{StaticResource MetadataTextStyle}" Text="专注时长" />
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{x:Bind ViewModel.FocusedDurationText, Mode=OneWay}" />
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="4">
                    <TextBlock Style="{StaticResource MetadataTextStyle}" Text="截图保留率" />
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="{x:Bind ViewModel.RetentionRateText, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <Grid x:Name="DistributionGrid" ColumnSpacing="32" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="活动类别" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="当前范围没有可统计的活动"
                        Visibility="{x:Bind ViewModel.IsCategoryEmpty, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="presentation:StatisticsBarItem">
                                <StackPanel Margin="0,0,0,12" Spacing="5">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Label}" />
                                        <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Value}" />
                                    </Grid>
                                    <ProgressBar Maximum="100" Value="{x:Bind Percent}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="效率分布" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="当前范围没有可统计的效率数据"
                        Visibility="{x:Bind ViewModel.IsProductivityEmpty, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.ProductivityItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="presentation:StatisticsBarItem">
                                <StackPanel Margin="0,0,0,12" Spacing="5">
                                    <Grid>
                                        <TextBlock Text="{x:Bind Label}" />
                                        <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Value}" />
                                    </Grid>
                                    <ProgressBar Maximum="100" Value="{x:Bind Percent}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <StackPanel Spacing="12">
                <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="录制过滤" />
                <ProgressBar Maximum="100" Value="{x:Bind ViewModel.RetentionRatePercent, Mode=OneWay}" />
                <Grid x:Name="FilterStatisticsGrid" ColumnSpacing="24" RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="采样" />
                        <TextBlock Text="{x:Bind ViewModel.SampledCountText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="黑屏过滤" />
                        <TextBlock Text="{x:Bind ViewModel.BlackFrameCountText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="重复丢弃" />
                        <TextBlock Text="{x:Bind ViewModel.DuplicateFrameCountText, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="保留" />
                        <TextBlock Text="{x:Bind ViewModel.RetainedFrameCountText, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Grid x:Name="OperationsGrid" ColumnSpacing="32" RowSpacing="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="分析调用" />
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="调用次数" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{x:Bind ViewModel.InvocationCountText, Mode=OneWay}" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="成功率" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{x:Bind ViewModel.InvocationSuccessRateText, Mode=OneWay}" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="平均延迟" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{x:Bind ViewModel.AverageLatencyText, Mode=OneWay}" TextWrapping="Wrap" />
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Token" />
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{x:Bind ViewModel.TokenUsageText, Mode=OneWay}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="12">
                    <TextBlock Style="{StaticResource SectionTitleTextStyle}" Text="本地存储" />
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.StorageTotalText, Mode=OneWay}" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.StorageItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="presentation:StatisticsBarItem">
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="{x:Bind Label}" />
                                    <TextBlock HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Value}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="首次使用" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.FirstStartedText, Mode=OneWay}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
