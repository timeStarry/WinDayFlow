<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <Platform Condition="'$(Platform)' == '' Or '$(Platform)' == 'AnyCPU' Or '$(Platform)' == 'Any CPU'">x64</Platform>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>WinDayFlow.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableDevLiveCapture)' == 'true' And '$(DevBundleBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);WDF_DEV_LIVE_CAPTURE</DefineConstants>
    <WdfNativeArtifactRoot>..\..\artifacts\native-dev</WdfNativeArtifactRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WdfNativeArtifactRoot)' == ''">
    <WdfNativeArtifactRoot>..\..\artifacts\native</WdfNativeArtifactRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup Condition="'$(Platform)' == 'x64'">
    <None Include="$(WdfNativeArtifactRoot)\x64\$(Configuration)\WinDayFlow.Capture.Native.dll"
          Link="WinDayFlow.Capture.Native.dll"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="Always"
          Condition="Exists('$(WdfNativeArtifactRoot)\x64\$(Configuration)\WinDayFlow.Capture.Native.dll')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinDayFlow.Application\WinDayFlow.Application.csproj" />
    <ProjectReference Include="..\WinDayFlow.Capture.Interop\WinDayFlow.Capture.Interop.csproj" />
    <ProjectReference Include="..\WinDayFlow.Composition\WinDayFlow.Composition.csproj" />
    <ProjectReference Include="..\WinDayFlow.Domain\WinDayFlow.Domain.csproj" />
    <ProjectReference Include="..\WinDayFlow.Infrastructure\WinDayFlow.Infrastructure.csproj" />
    <ProjectReference Include="..\WinDayFlow.Presentation\WinDayFlow.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Assets\WinDayFlow.ico"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\WinDayFlow.png"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="Assets\WinDayFlow.svg"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE"
          Link="LICENSE"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD_PARTY_NOTICES.md"
          Link="THIRD_PARTY_NOTICES.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\DEV_BUNDLE_LOCAL_ONLY.txt"
          Link="DEV_BUNDLE_LOCAL_ONLY.txt"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\docs\provenance\QiDayflow-capture.md"
          Link="docs\provenance\QiDayflow-capture.md"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\docs\provenance\QiDayflow-capture.manifest.json"
          Link="docs\provenance\QiDayflow-capture.manifest.json"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\licenses\**\*"
          Link="licenses\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="IncludeWinUIAppResourcesInPublish" AfterTargets="Publish">
    <ItemGroup>
      <_WinUIAppPri Include="$(TargetDir)$(TargetName).pri"
                    Condition="Exists('$(TargetDir)$(TargetName).pri')" />
      <_WinUIAppXbf Include="$(TargetDir)**\*.xbf"
                    Exclude="$(PublishDir)**\*.xbf" />
    </ItemGroup>

    <Error Condition="'@(_WinUIAppPri)' == ''"
           Text="WinUI publish is missing $(TargetName).pri in $(TargetDir)." />
    <Error Condition="'@(_WinUIAppXbf)' == ''"
           Text="WinUI publish found no compiled XAML resources in $(TargetDir)." />

    <Copy SourceFiles="@(_WinUIAppPri)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WinUIAppXbf)"
          DestinationFiles="@(_WinUIAppXbf->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
