<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WinDayFlow.Capture.Interop</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableDevLiveCapture)' == 'true' And '$(DevBundleBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);WDF_DEV_LIVE_CAPTURE</DefineConstants>
    <WdfNativeArtifactRoot>..\..\artifacts\native-dev</WdfNativeArtifactRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WdfNativeArtifactRoot)' == ''">
    <WdfNativeArtifactRoot>..\..\artifacts\native</WdfNativeArtifactRoot>
  </PropertyGroup>

  <ItemGroup Condition="'$(Platform)' == 'x64'">
    <None Include="$(WdfNativeArtifactRoot)\x64\$(Configuration)\WinDayFlow.Capture.Native.dll"
          Link="WinDayFlow.Capture.Native.dll"
          CopyToOutputDirectory="Always"
          CopyToPublishDirectory="Always"
          Condition="Exists('$(WdfNativeArtifactRoot)\x64\$(Configuration)\WinDayFlow.Capture.Native.dll')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinDayFlow.Application\WinDayFlow.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinDayFlow.Infrastructure.Tests" />
  </ItemGroup>
</Project>
