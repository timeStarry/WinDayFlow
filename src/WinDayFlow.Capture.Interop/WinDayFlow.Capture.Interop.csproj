<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WinDayFlow.Capture.Interop</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup Condition="'$(Platform)' == 'x64'">
    <None Include="..\..\artifacts\native\x64\$(Configuration)\WinDayFlow.Capture.Native.dll"
          Link="WinDayFlow.Capture.Native.dll"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Condition="Exists('..\..\artifacts\native\x64\$(Configuration)\WinDayFlow.Capture.Native.dll')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinDayFlow.Application\WinDayFlow.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WinDayFlow.Infrastructure.Tests" />
  </ItemGroup>
</Project>
