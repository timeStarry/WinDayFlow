<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>WinDayFlow.Infrastructure.Tests</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Condition="'$(EnableDevLiveCapture)' == 'true' And '$(DevBundleBuild)' == 'true'">
    <DefineConstants>$(DefineConstants);WDF_DEV_LIVE_CAPTURE</DefineConstants>
    <WdfNativeArtifactRoot>..\..\artifacts\native-dev</WdfNativeArtifactRoot>
  </PropertyGroup>

  <PropertyGroup Condition="'$(WdfNativeArtifactRoot)' == ''">
    <WdfNativeArtifactRoot>..\..\artifacts\native</WdfNativeArtifactRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(EnableDevLiveCapture)' == 'true' And '$(DevBundleBuild)' == 'true'">
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <Compile Include="..\..\src\WinDayFlow.App\Services\DevLiveCaptureHostedService.cs"
             Link="App\DevLiveCaptureHostedService.cs" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\WinDayFlow.App\Services\CaptureAwareWindowCloseCoordinator.cs"
             Link="App\CaptureAwareWindowCloseCoordinator.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Platform)' == 'x64'">
    <None Include="$(WdfNativeArtifactRoot)\x64\$(Configuration)\WinDayFlow.Capture.Native.dll"
          Link="WinDayFlow.Capture.Native.dll"
          CopyToOutputDirectory="Always"
          Condition="Exists('$(WdfNativeArtifactRoot)\x64\$(Configuration)\WinDayFlow.Capture.Native.dll')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WinDayFlow.Capture.Interop\WinDayFlow.Capture.Interop.csproj" />
    <ProjectReference Include="..\..\src\WinDayFlow.Infrastructure\WinDayFlow.Infrastructure.csproj" />
  </ItemGroup>
</Project>
